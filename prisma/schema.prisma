generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STAFF
  SUPERVISOR
}

enum Frequency {
  MONTHLY
  ANNUAL
  ANNUAL_WORKFLOW
}

enum TaskStatus {
  TODO // รอดำเนินการ
  WAITING_DOCS // รอเอกสารจากลูกค้า
  PROCESSING // กำลังจัดทำ
  FILED // ยื่นแบบแล้ว (ผ่านชั่วขณะ ระบบเลื่อนต่อให้อัตโนมัติ)
  AWAITING_CLIENT_PAYMENT // รอลูกค้าชำระ
  AWAITING_OFFICE_PAYMENT // รอหัวหน้าชำระ
  DONE // เสร็จสิ้น (เดิม SUBMITTED)
  NOT_FILING // ไม่ยื่นเดือนนี้
}

enum PaymentType {
  CLIENT_PAYS // ลูกค้าชำระเอง
  OFFICE_PAYS // สำนักงานชำระแทน
  NO_ADDITIONAL // ไม่ต้องชำระเพิ่ม
  NO_TAX // ไม่มีภาษีต้องชำระ
}

enum NotificationType {
  REMINDER
  ESCALATION
  MANUAL
}

enum FilingMethod {
  PAPER
  E_FILING
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum CalcMethod {
  fixed_day
  offset_days
  offset_months
}

enum ReferenceDate {
  month_end
  fiscal_year_end
  agm_date
  half_year_end
}

enum HolidayType {
  public_holiday
  special_holiday
  government_holiday
  substitution_holiday
}

enum AssignmentScope {
  CLIENT
  TAX_TYPE
}

model User {
  id                         String                @id
  name                       String
  email                      String                @unique
  password                   String
  role                       Role
  isActive                   Boolean               @default(true)
  lineUserId                 String?               @unique
  totpSecretEnc              String? // FR-109: encrypted TOTP secret (set while enrolling)
  totpEnabledAt              DateTime? // null = not enrolled yet; changes invalidate remembered devices
  politeParticle             String                @default("ครับ") // answer 16: ending of messages this person sends
  createdAt                  DateTime              @default(now())
  assignedClients            Client[]              @relation("ClientAssignedStaff")
  assignedTaxTypes           TaxType[]             @relation("TaxTypeAssignedStaff")
  assignedTasks              Task[]                @relation("TaskAssignedUser")
  ledTeams                   Team[]                @relation("TeamLead")
  teamMemberships            TeamMember[]
  notifications              NotificationLog[]
  lineLinkTokens             LineLinkToken[]
  assignmentHistoryFrom      AssignmentHistory[]   @relation("AssignmentHistoryFromUser")
  assignmentHistoryTo        AssignmentHistory[]   @relation("AssignmentHistoryToUser")
  assignmentHistoryChangedBy AssignmentHistory[]   @relation("AssignmentHistoryChangedBy")
  taskStatusChanges          TaskStatusHistory[]   @relation("TaskStatusChangedBy")
  clientsCreated             Client[]              @relation("ClientCreatedBy")
  clientsUpdated             Client[]              @relation("ClientUpdatedBy")
  notes                      Note[]
  credentialsUpdated         GovCredential[]       @relation("CredentialUpdatedBy")
  credentialLogs             CredentialAccessLog[]
}

model LineLinkToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id         String       @id
  name       String
  leadUserId String
  createdAt  DateTime     @default(now())
  leadUser   User         @relation("TeamLead", fields: [leadUserId], references: [id], onDelete: Restrict)
  members    TeamMember[]
  clients    Client[]

  @@index([leadUserId])
}

model TeamMember {
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model Client {
  id                String              @id
  companyName       String
  taxId             String?
  branchCode        String              @default("00000") // 00000 = สำนักงานใหญ่ (round 3)
  branchName        String?
  businessType      String
  fiscalYearStart   Int
  fiscalYearEnd     Int
  fiscalYearEndDay  Int
  isNonStandard     Boolean             @default(false)
  filingMethod      FilingMethod?
  assignedStaffId   String?
  teamId            String?
  auditorName       String? // FR-86 ผู้สอบบัญชี (free text)
  monthlyFee        Decimal?            @db.Decimal(14, 2) // answer 16: ค่าบริการทำบัญชีรายเดือน (prefills the payment message)
  isActive          Boolean             @default(true) // FR-105
  serviceEndDate    DateTime?           @db.Date // FR-105: no new tasks for periods after this date
  createdById       String? // FR-70
  updatedById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime?           @updatedAt
  assignedStaff     User?               @relation("ClientAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdBy         User?               @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?               @relation("ClientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  team              Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  taxTypes          TaxType[]
  tasks             Task[]
  assignmentHistory AssignmentHistory[]
  notes             Note[]
  govCredentials    GovCredential[]

  // One record per branch: a tax id may repeat only with a different branch code
  @@unique([taxId, branchCode])
  @@index([assignedStaffId])
  @@index([teamId])
}

model TaxType {
  id                 String              @id
  name               String
  frequency          Frequency
  clientId           String
  assignedStaffId    String?
  defaultPaymentType PaymentType         @default(CLIENT_PAYS)
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedStaff      User?               @relation("TaxTypeAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  tasks              Task[]
  assignmentHistory  AssignmentHistory[]

  @@unique([clientId, name])
  @@index([assignedStaffId])
}

model Rule {
  id            String        @id
  ruleCode      String        @unique
  name          String
  description   String?
  taxForm       String?
  calcMethod    CalcMethod
  fixedDay      Int?
  offset        Int?
  referenceDate ReferenceDate
  legalRef      String
  updatedAt     DateTime?
  daysOffset    Int?
  taxTypeName   String?
  hasPayment    Boolean       @default(true) // false = งานที่ไม่มีการชำระ (DBD, AGM, จัดทำงบ) ยื่นแล้วเสร็จสิ้นทันที

  @@index([taxForm])
}

model Task {
  id                String              @id
  clientId          String
  taxTypeId         String
  assignedUserId    String
  fiscalYearEndDate DateTime
  dueDate           DateTime
  ruleUsed          String?
  status            TaskStatus
  priority          TaskPriority?
  mddScore          Float?
  evidenceUrls      String[]
  note              String?
  paymentType       PaymentType         @default(CLIENT_PAYS)
  docsRequestedAt   DateTime?           @db.Date
  docsReceivedAt    DateTime?           @db.Date
  filedAt           DateTime?           @db.Date
  taxAmount         Decimal?            @db.Decimal(14, 2)
  clientPaidAt      DateTime?           @db.Date
  clientSlipUrls    String[]
  officePaidAt      DateTime?           @db.Date
  receiptUrls       String[]
  notFilingReason   String?
  completedAt       DateTime?
  // FR-102: late filing/payment — penalty and surcharge, who bears them, why
  penaltyAmount     Decimal?            @db.Decimal(14, 2)
  surchargeAmount   Decimal?            @db.Decimal(14, 2)
  penaltyBorneBy    PenaltyPayer?
  penaltyReason     String?
  // FR-101: annual financial statements with the auditor
  auditorSentAt     DateTime?           @db.Date
  auditorReportAt   DateTime?           @db.Date
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  statusHistory     TaskStatusHistory[]
  client            Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  taxType           TaxType             @relation(fields: [taxTypeId], references: [id], onDelete: Restrict)
  assignedUser      User                @relation("TaskAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict)
  notifications     NotificationLog[]

  @@unique([clientId, taxTypeId, fiscalYearEndDate])
  @@index([assignedUserId])
  @@index([dueDate])
  @@index([status])
}

model TaskStatusHistory {
  id          String      @id
  taskId      String
  fromStatus  TaskStatus?
  toStatus    TaskStatus
  changedById String
  changedAt   DateTime    @default(now())
  reason      String?
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy   User        @relation("TaskStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([taskId, changedAt])
}

model TaskGenerationRun {
  id          String    @id
  scope       String
  clientId    String?
  dryRun      Boolean   @default(false)
  status      String
  created     Int       @default(0)
  skipped     Int       @default(0)
  wouldCreate Int       @default(0)
  errors      Json
  triggeredBy String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([startedAt])
  @@index([clientId])
  @@index([status])
}

model NotificationLog {
  id     String           @id
  taskId String
  userId String
  type   NotificationType
  sentAt DateTime         @default(now())
  task   Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([sentAt])
}

model AssignmentHistory {
  id          String          @id
  scope       AssignmentScope
  clientId    String
  taxTypeId   String?
  fromUserId  String?
  toUserId    String
  changedById String
  changedAt   DateTime        @default(now())
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxType     TaxType?        @relation(fields: [taxTypeId], references: [id], onDelete: Cascade)
  fromUser    User?           @relation("AssignmentHistoryFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser      User            @relation("AssignmentHistoryToUser", fields: [toUserId], references: [id], onDelete: Restrict)
  changedBy   User            @relation("AssignmentHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([taxTypeId])
  @@index([changedAt])
}

model ThaiHoliday {
  id             String      @id
  date           DateTime    @unique @db.Date
  nameTh         String
  nameEn         String
  type           HolidayType
  isSubstitution Boolean     @default(false)
  note           String?

  @@index([type])
}

enum NoteScope {
  PERSONAL // เห็นเฉพาะผู้สร้าง
  SHARED // ทุกคนเห็น
}

/// FR-93–97: Post-it notes on the dashboard, optionally tied to a company.
model Note {
  id        String    @id
  ownerId   String
  scope     NoteScope
  content   String    @db.VarChar(500)
  color     String    @default("yellow")
  clientId  String?
  pinned    Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([scope])
  @@index([clientId])
}

enum GovSystem {
  RD // กรมสรรพากร
  DBD // กรมพัฒนาธุรกิจการค้า
  SSO // ประกันสังคม
}

/// FR-71: login for a government website. Shared by every branch of the same tax id (answer 8);
/// companies without a tax id keep their own (clientId).
model GovCredential {
  id          String                @id
  taxId       String?
  clientId    String?
  system      GovSystem
  username    String
  passwordEnc String // NFR-09: AES-256-GCM
  note        String?
  updatedById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  client      Client?               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  updatedBy   User?                 @relation("CredentialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  accessLogs  CredentialAccessLog[]

  @@index([taxId])
  @@index([clientId])
}

enum CredentialAction {
  VIEW
  COPY
  CREATE
  UPDATE
  DELETE
}

/// FR-74 / NFR-12: append-only; there is no API to change or delete rows. The credential link is
/// nulled if the credential is deleted, the snapshot columns keep the row readable.
model CredentialAccessLog {
  id           String           @id
  credentialId String?
  userId       String
  action       CredentialAction
  system       GovSystem
  companyLabel String
  username     String
  at           DateTime         @default(now())
  credential   GovCredential?   @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([at])
  @@index([credentialId])
}

enum PenaltyPayer {
  CLIENT // ลูกค้า
  OFFICE // สำนักงาน
}

/// Office-wide settings edited by supervisors (answer 16: transfer details and message wording).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
